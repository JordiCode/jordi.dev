{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@icons/*": [
        "./src/components/icons/*"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
    },
    "jsx": "react-jsx",
  }
}