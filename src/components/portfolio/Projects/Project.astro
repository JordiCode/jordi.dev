---
import LoadingIcon from "../icons/LoadingIcon.astro";
import GithubIcon from "../icons/Stack/GithubIcon.astro";

const statusColor: { [key: string]: string } = {
  production: "bg-green-700",
  building: "bg-yellow-700",
  disabled: "bg-red-500",
  design: "bg-gray-700",
};

const { status, srcImg, title, description, link } = Astro.props;
---

<div class="project">
  <div class={"flex flex-col max-lg:grid"}>
    <div class="relative min-h-24">
      <img
        data-src={srcImg}
        class="relative z-10 projectImg border-zinc-600
         max-lg:max-w-full border rounded-lg"
      />
      <span class="absolute top-0 left-0 flex gap-4">
        <LoadingIcon />
        <p class="text-sm font-light">loading</p>
      </span>
    </div>

    <div class="pt-4">
      <div class={"flex flex-col items-start gap-2 mb-5"}>
        <h2 class="text-2xl">{title}</h2>
        <span
          class={`text-sm ${statusColor[status]} text-white  px-4 py-0.5 rounded-md capitalize`}
          title={"Status"}
        >
          {status}
        </span>
      </div>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-4">
        {description}
      </p>
      <div class="flex">
        <a
          href={link.view.href}
          target={"_blank"}
          role="link"
          class={`flex items-center gap-2 hover:bg-blue-400 w-max rounded-md px-3 py-2 text-sm`}
        >
          <link.view.icon />
          <span>{link.view.title}</span>
        </a>
        {
          link.github && (
            <a
              href={link.github.href}
              target={"_blank"}
              role="link"
              class={`flex items-center gap-2 hover:bg-blue-400 w-max rounded-md px-3 py-2 text-sm`}
            >
              <GithubIcon />
              <span>Github</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</div>
