---
const { classes } = Astro.props;
import { workExperiences as workExperiencesData } from "@data/workExperiences";
import Card from "@components/ui/Card.astro";
import DotsIcon from "@icons/DotsIcon.astro";
import WorkIcon from "@icons/WorkIcon.astro";
import ArrowUp from "@icons/ArrowUp.astro";
---

<Card classes={classes}>
  <div class="flex gap-2 items-center mb-6">
    <WorkIcon />
    <h2 class="text-black dark:text-white text-2xl mb-0!">Work Experience</h2>
  </div>
  <div class="grid gap-3 mb-2">
    {
      workExperiencesData.map(
        ({ title, company, startDate, endDate, description }) => {
          return (
            <div class="workExp-wrapper p-3 rounded-xl bg-blue-300 dark:bg-blue-950 hidden">
              <p class="text-xs mb-2 text-slate-800 dark:text-slate-200">
                {startDate} - {endDate}
              </p>
              <h3 class="text-xl font-bold text-slate-900 dark:text-slate-50">
                {company}
              </h3>
              <p class="dark:text-slate-400 text-black/55 mb-2 text-sm font-medium">
                {title}
              </p>
              <div class="workExp-details-wrapper relative rounded-lg h-max">
                <p class="workExp-details bg-background rounded-lg hidden text-xs leading-5 p-3">
                  {description}
                </p>
                <span class="workExp-button p-3 hover:bg-background flex w-full font-medium  gap-2 items-center justify-start cursor-pointer rounded-lg">
                  <DotsIcon classes="size-4 min-w-4" />
                  <p>Details</p>
                </span>
                <div class="text-white hidden text-center cursor-pointer w-6 h-6 rounded-full bg-red-500 hover:bg-red-600 absolute top-0 -translate-y-1/2 right-0 items-center justify-center">
                  -
                </div>
              </div>
            </div>
          );
        },
      )
    }
  </div>
  <button
    class=`
    workExpSectionButton
    cursor-pointer w-full text-white px-3 py-2 rounded-xl bg-blue-400 dark:bg-blue-950 
     hover:bg-blue-500 dark:hover:bg-blue-900 transition-all flex items-center justify-center gap-2 `
  >
    <ArrowUp classes="size-6 rotate-180" />
  </button>
</Card>

<script is:inline>
  const workExp = document.querySelectorAll(".workExp-wrapper");
  const workExpSectionButton = document.querySelector(".workExpSectionButton");

  workExpSectionButton.addEventListener("click", () => {
    workExpSectionButton.children[0].classList.toggle("rotate-180");

    workExp.forEach((currentWe, index) => {
      if (index === 0) {
        return;
      }
      currentWe.classList.toggle("hidden");
    });
  });

  workExp.forEach((currentWe, index) => {
    if (index === 0) {
      currentWe.classList.toggle("hidden");
    }

    const workExpDetailsWrapper = currentWe.querySelector(
      ".workExp-details-wrapper",
    );

    const workExpDetails = workExpDetailsWrapper.children[0];
    const workExpDetailsButton = workExpDetailsWrapper.children[1];
    const workExpDetailsCloseButton = workExpDetailsWrapper.children[2];

    workExpDetailsCloseButton.addEventListener("click", () => {
      workExpDetails.classList.add("hidden");
      workExpDetailsCloseButton.classList.add("hidden");
      workExpDetailsButton.classList.remove("hidden");
    });

    workExpDetailsButton.addEventListener("click", () => {
      workExpDetailsButton.classList.add("hidden");
      workExpDetails.classList.remove("hidden");
      workExpDetailsCloseButton.classList.remove("hidden");
    });
  });
</script>
