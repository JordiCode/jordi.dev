---
import UserIcon from "@icons/UserIcon.astro";
import Card from "@components/ui/Card.astro";
---

<Card classes="bg-blue-300 dark:dark:bg-blue-950">
    <div class="flex gap-2" id="aboutMe">
        <UserIcon classes="size-6 " />
        <h3>About Me</h3>
    </div>
    <Card classes="py-6">
        <p class="intro font-light">
            <strong>Front-End Web Developer</strong> passionate about building clean,
            user-friendly interfaces. I love learning new things, solving problems,
            and working with a team to create elegant, effective solutions.
        </p>
        <br />
        <p>
            <div class="projects">
                <h2 class="text-lg">Featured Projects:</h2>
                <p class="mb-3 font-light">
                    I'm currently working on 2 special projects:
                </p>
                <ul class="interests pl-2 grid gap-3">
                    <li>
                        <a
                            href="https://www.figma.com/design/FQ8MnQH6LaXT5WSTphUHjT/Archit?node-id=0-1&t=rcTd4OLT7H4PB3C9-1"
                            class="hover:bg-blue-400 p-2 rounded-md"
                            target="_blank"
                        >
                            <span>⭐️ Archit:</span>
                            <span class="font-light">
                                Social network focused on personal productivity
                            </span>
                        </a>
                        <li>
                            <a
                                href="https://www.figma.com/design/j6NhW3EjNLkiEPZ4Scqqmb/AppLanguages?node-id=0-1&t=rcTd4OLT7H4PB3C9-1"
                                class="hover:bg-blue-400 p-2 rounded-md"
                                target="_blank"
                            >
                                <span>⭐️ ComLang:</span>
                                <span class="font-light">
                                    Language learning desktop app
                                </span>
                            </a>
                        </li>
                    </li>
                </ul>
            </div>
        </p>
    </Card>
</Card>
